+const command=()=>({op:'create',request_id:'queue-request-01',task:{intent:'Synthetic work',next_step:'Write KIKI_OK',origin:{source:'control_room_web'},privacy:'synthetic',authorization:'pending',status:'PROPOSED',idempotency_key:'dedupe-0001'}});
