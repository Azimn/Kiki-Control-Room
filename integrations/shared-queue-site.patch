+ const d=new D1;await linkOwner(d,owner,'o','o');const c=command();await queueCommand(d,owner,c);await queueCommand(d,owner,c);
+ assert.equal(d.db.prepare('SELECT COUNT(*) n FROM tasks').get().n,0);assert.equal((await queueView(d,owner)).requests.length,1);
+ assert.equal((await queueView(d,owner)).online,false);await assert.rejects(queueCommand(d,owner,{...c,task:{...c.task,intent:'changed'}}),/conflict/);
+ const r=await exchange(d,snap(1));assert.equal(r.actions[0].payload.command.request_id,owner+':'+c.request_id);
+});
+test('SQLite result and same ID evidence are projected once; stale sync cannot replace them',async()=>{
+ const d=new D1;await linkOwner(d,owner,'o','o');await queueCommand(d,owner,command());
+ const task={id:'task-11111111-1111-4111-8111-111111111111',owner,status:'VERIFIED',evidence:{provider_receipt:'receipt-synthetic-readback'}};
+ const s=snap(2,{authority:'windows_sqlite',tasks:[task],runtimes:[]});s.results=[{request_id:owner+':queue-request-01',status:'applied',queue_result:task}];
+ await exchange(d,s);await exchange(d,snap(1));const v=await queueView(d,owner);assert.equal(v.tasks[0].id,task.id);assert.equal(v.tasks[0].evidence.provider_receipt,task.evidence.provider_receipt);assert.equal(v.requests[0].result.result.id,task.id);
+});
+test('cross-owner access and execution impersonation fail closed',async()=>{
+ const d=new D1;await linkOwner(d,owner,'o','o');await assert.rejects(queueView(d,'other-owner'));await assert.rejects(queueCommand(d,'other-owner',command()));
+ await assert.rejects(queueCommand(d,owner,{op:'claim',request_id:'claim-request'}),/signed/);
+ const c=command();c.task.origin.source='chatgpt';c.task.authorization='approved';await assert.rejects(queueCommand(d,owner,c,'chatgpt'),/approval/);
+ const bad=snap(1,{authority:'windows_sqlite',tasks:[{owner:'other-owner'}]});await assert.rejects(exchange(d,bad),/owner/);
+});
+test('network failure preserves idempotent command for reconnect',async()=>{
+ const d=new D1;await linkOwner(d,owner,'o','o');await queueCommand(d,owner,command());const first=await exchange(d,snap(1));const retry=await exchange(d,snap(2));assert.equal(first.actions[0].request_id,retry.actions[0].request_id);
+});
+test('expired capability TTL is never advertised from a stale snapshot',async()=>{
