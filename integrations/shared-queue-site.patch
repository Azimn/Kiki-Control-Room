+// Durable requests + projection only. Windows SQLite evaluates every mutation.
+const jsonHeaders={'Cache-Control':'no-store'};
+export async function queueView(db,owner){
+ const row=await db.prepare('SELECT snapshot_json,last_seen FROM desktop_sync WHERE owner_id=?').bind(owner).first();
+ if(!row)throw Error('Owner task pairing required.');
+ const snapshot=JSON.parse(row.snapshot_json);
+ const online=!!row.last_seen&&Date.now()-Date.parse(row.last_seen)<60000;
+ const shared=snapshot.shared_queue||{tasks:[],runtimes:[]};
+ const runtimes=(shared.runtimes||[]).map(r=>({...r,online:online&&r.expires*1000>Date.now()}));
+ const tasks=(shared.tasks||[]).map(t=>({...t,eligible_runtimes:(t.eligible_runtimes||[]).filter(id=>runtimes.some(r=>r.runtime===id&&r.online)),availability_reason:online?t.availability_reason:'Windows task authority offline; runtime health unconfirmed.'}));
+ const requests=await db.prepare("SELECT request_id,status,result_json,created_at FROM desktop_actions WHERE owner_id=? AND action='shared_queue' ORDER BY created_at DESC LIMIT 40").bind(owner).all();
+ return {authority:'windows_sqlite',snapshot_at:row.last_seen,online,tasks,runtimes,requests:requests.results.map(r=>({...r,result:r.result_json?JSON.parse(r.result_json):null})),
+  connector_note:'Connector tools require refreshed deployment/approval. Local adapters cannot invoke ChatGPT connectors.'};
+}
+export async function queueCommand(db,owner,command,source='control_room_web'){
+ if(!command||typeof command!=='object'||Array.isArray(command)||JSON.stringify(command).length>10000)throw Error('Invalid bounded command.');
+ if(!['create','update'].includes(command.op))throw Error('Use signed runtime credentials for claims and execution.');
+ if(typeof command.request_id!=='string'||!/^[a-zA-Z0-9:_-]{8,100}$/.test(command.request_id))throw Error('Stable request_id required.');
+ if(command.op==='create'){
+  const t=command.task;
+  if(!t||typeof t.intent!=='string'||t.intent.length>500||typeof t.next_step!=='string'||t.next_step.length>500)throw Error('Intent and minimal next step required.');
+  if(t.privacy!=='synthetic'&&t.privacy!=='private')throw Error('Protected/student data unsupported.');
+  if(!t.origin||t.origin.source!==source)throw Error('Preserve actual source attribution.');
+  // ChatGPT proposes; only the owner browser may grant execution approval.
+  if(source==='chatgpt'&&t.authorization==='approved')throw Error('Account access is separate from action approval. Request owner approval.');
+ }
+ const linked=await db.prepare('SELECT owner_id FROM desktop_sync WHERE owner_id=?').bind(owner).first();
+ if(!linked)throw Error('Owner task pairing required.');
+ const id=owner+':'+command.request_id;
+ const relayed={...command,request_id:id};
+ const payload=JSON.stringify({command:relayed,source});
+ const prior=await db.prepare('SELECT * FROM desktop_actions WHERE request_id=?').bind(id).first();
+ if(prior){if(prior.owner_id!==owner||prior.payload_json!==payload)throw Error('Idempotency conflict');return {request_id:command.request_id,status:prior.status,result:prior.result_json?JSON.parse(prior.result_json):null}}
+ const count=await db.prepare("SELECT COUNT(*) n FROM desktop_actions WHERE owner_id=? AND action='shared_queue' AND created_at>datetime('now','-1 minute')").bind(owner).first();
+ if(count.n>=30)throw Error('Request rate limit; retry later.');
+ // The relay request id is owner-scoped and also used for SQLite deduplication.
+ await db.prepare("INSERT INTO desktop_actions(request_id,owner_id,task_id,action,payload_json) VALUES(?,?,?,'shared_queue',?) ON CONFLICT DO NOTHING")
+ .bind(id,owner,command.id||'task-'+crypto.randomUUID(),payload).run();
+ return {request_id:command.request_id,status:'pending',authority:'windows_sqlite',message:'Request saved; waiting for Windows commit.'};
+}
+export {jsonHeaders};
