+class D1{
+ constructor(){this.db=new DatabaseSync(':memory:');for(const f of ['0000_hard_umar.sql','0001_thankful_nick_fury.sql'])this.db.exec(fs.readFileSync(new URL('../drizzle/'+f,import.meta.url),'utf8'))}
+ prepare(q){let a=[];const db=this.db,p={bind(...v){a=v;return p},async first(){return db.prepare(q).get(...a)||null},async all(){return {results:db.prepare(q).all(...a)}},async run(){return {meta:db.prepare(q).run(...a)}}};return p}
+ async batch(stmts){this.db.exec('BEGIN');try{const r=[];for(const s of stmts)r.push(await s.run());this.db.exec('COMMIT');return r}catch(e){this.db.exec('ROLLBACK');throw e}}
+}
