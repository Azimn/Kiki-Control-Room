@@ -0,0 +1,16 @@
+import {env} from 'cloudflare:workers';
+import {queueView,queueCommand,jsonHeaders} from '../../../lib/shared-queue.mjs';
+export const dynamic='force-dynamic';
+export async function GET(r:Request){
+ const owner=r.headers.get('oai-authenticated-user-id');if(!owner)return Response.json({error:'Sign in required'},{status:401});
+ try{return Response.json(await queueView(env.DB,owner),{headers:jsonHeaders})}
+ catch{return Response.json({error:'Owner task pairing unavailable'},{status:403,headers:jsonHeaders})}
+}
+export async function POST(r:Request){
+ const owner=r.headers.get('oai-authenticated-user-id');if(!owner)return Response.json({error:'Sign in required'},{status:401});
+ if(r.headers.get('origin')!==new URL(r.url).origin)return Response.json({error:'Origin rejected'},{status:403});
+ if(!r.headers.get('content-type')?.startsWith('application/json'))return Response.json({error:'JSON required'},{status:415});
+ try{const raw=await r.text();if(raw.length>12000)return Response.json({error:'Too large'},{status:413});
+ return Response.json(await queueCommand(env.DB,owner,JSON.parse(raw)),{headers:jsonHeaders})}
+ catch(e){return Response.json({error:e instanceof Error?e.message:'Request rejected'},{status:400,headers:jsonHeaders})}
+}
