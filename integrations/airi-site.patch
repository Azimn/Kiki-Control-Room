+import {env} from 'cloudflare:workers';
+import {listDevices,enroll,revoke} from '../../../lib/companion.mjs';
+export const dynamic='force-dynamic';
+function owner(r:Request){const id=r.headers.get('oai-authenticated-user-id');if(!id)throw Error('Sign in required.');return id}
+export async function GET(r:Request){try{return Response.json({devices:await listDevices(env.DB,owner(r))},{headers:{'Cache-Control':'no-store'}})}catch{return Response.json({error:'Sign in required.'},{status:401})}}
+export async function POST(r:Request){try{const id=owner(r);if(r.headers.get('origin')!==new URL(r.url).origin)throw Error('Origin rejected.');const raw=await r.text();if(raw.length>1000)throw Error('Request too large.');const a=JSON.parse(raw);if(a.action==='revoke')return Response.json(await revoke(env.DB,id,a.id));if(a.action!=='enroll')throw Error('Invalid device action.');const access=(env as any).KIKI_COMPANION_SITE_ACCESS;if(!access)throw Error('Laptop enrollment is not configured yet.');const credentials=await enroll(env.DB,id,a.label||'AIRI laptop');return Response.json({...credentials,site_url:new URL(r.url).origin,site_access_token:access},{headers:{'Cache-Control':'no-store'}})}catch(e){return Response.json({error:e instanceof Error?e.message:'Enrollment failed.'},{status:400})}}
