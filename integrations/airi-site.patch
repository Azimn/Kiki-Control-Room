+'use client';
+import {useState,useEffect} from 'react';
+export default function CompanionDevices(){
+ const [devices,setDevices]=useState<any[]>([]),[busy,setBusy]=useState(false),[note,setNote]=useState('');
+ async function refresh(){const r=await fetch('/api/companion-devices');if(!r.ok)throw Error('Unable to load paired devices.');const data:any=await r.json();setDevices(data.devices)}
+ useEffect(()=>{refresh().catch(e=>setNote(e.message))},[]);
+ async function act(a:any){setBusy(true);try{const r=await fetch('/api/companion-devices',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(a)});const result:any=await r.json();if(!r.ok)throw Error(result.error);if(a.action==='enroll'){const url=URL.createObjectURL(new Blob([JSON.stringify(result,null,2)],{type:'application/json'}));const link=document.createElement('a');link.href=url;link.download='kiki-laptop-pairing.json';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);setNote('Pairing file downloaded. Import it in the laptop bridge, then delete this downloaded copy. It contains private access credentials.')}else setNote('Device access revoked.');await refresh()}catch(e){setNote((e as Error).message)}finally{setBusy(false)}}
+ return <div className="settings-card"><h2>AIRI laptop companion</h2><p>Use your laptop’s local model with Kiki’s shared history. Pairing grants this device access to your recorded conversations and shared work session.</p><button disabled={busy} onClick={()=>act({action:'enroll',label:'AIRI laptop'})}>Pair my laptop</button>{devices.map(d=><div key={d.id}><p>{d.label}: {d.revoked?'Revoked':d.last_seen?'Last connected '+new Date(d.last_seen).toLocaleString():'Waiting for first connection'}</p>{!d.revoked&&<button disabled={busy} onClick={()=>act({action:'revoke',id:d.id})}>Revoke access</button>}</div>)}<p aria-live="polite">{note}</p></div>
+}
