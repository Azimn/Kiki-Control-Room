--- /dev/null
+++ b/app/api/companion/route.ts
@@ -0,0 +1,7 @@
+import {env} from 'cloudflare:workers';
+import {authorizeDevice,companionRequest} from '../../../lib/companion.mjs';
+export const dynamic='force-dynamic';
+export async function POST(r:Request){
+ try{const token=r.headers.get('authorization')?.replace(/^Bearer /,'');const device=await authorizeDevice(env.DB,token);const raw=await r.text();if(raw.length>20000)return Response.json({error:'Request too large.'},{status:413});const result=await companionRequest(env.DB,device,JSON.parse(raw));return Response.json(result,{headers:{'Cache-Control':'no-store'}})}
+ catch(e){return Response.json({error:e instanceof Error?e.message:'Companion request failed.'},{status:400,headers:{'Cache-Control':'no-store'}})}
+}
